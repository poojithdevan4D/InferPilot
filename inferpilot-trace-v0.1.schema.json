{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferpilot.dev/schemas/trace-v0.1.schema.json",
  "title": "InferPilot sanitized request trace row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_version",
    "request_id",
    "arrival_offset_ms",
    "input_tokens",
    "output_tokens",
    "status",
    "deadline_class"
  ],
  "properties": {
    "trace_version": {"const": "0.1"},
    "request_id": {
      "type": "string",
      "minLength": 1,
      "description": "Random identifier created for this export; never a production request or user ID."
    },
    "arrival_offset_ms": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 1},
    "output_tokens": {"type": "integer", "minimum": 0},
    "requested_output_tokens": {"type": ["integer", "null"], "minimum": 1},
    "ttft_ms": {"type": ["number", "null"], "minimum": 0},
    "itl_ms": {"type": ["number", "null"], "minimum": 0},
    "e2e_ms": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["ok", "error", "timeout", "cancelled", "censored"]},
    "error_class": {
      "type": ["string", "null"],
      "description": "Coarse allowlisted class only; no raw exception text."
    },
    "deadline_class": {"type": "string", "minLength": 1},
    "prefix_class_hash": {
      "type": ["string", "null"],
      "description": "Opaque value produced with an export-specific keyed hash; never a plain prompt hash."
    },
    "tenant_class": {
      "type": ["string", "null"],
      "description": "Coarse class with at least 20 requests; never a customer or account name."
    },
    "lora_class_hash": {"type": ["string", "null"]},
    "cache_hit": {"type": ["boolean", "null"]},
    "timestamp_bucket": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Optional coarse UTC bucket; prefer arrival offsets where possible."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {"required": ["ttft_ms", "e2e_ms"]}
    },
    {
      "if": {"properties": {"output_tokens": {"minimum": 2}}},
      "then": {"required": ["itl_ms"]}
    }
  ]
}
